{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Experiment": {
      "title": "Experiment",
      "description": "Trading research experiment backtest and forward test studies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "pair": { "type": "string" },
        "timeframe": { "type": "string" },
        "session": { "type": "string" },
        "setupModel": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "sampleSize": { "type": "number" },
        "trades": { "type": "array" },
        "keyFinding": { "type": "string" },
        "hypotheses": { "type": "string" },
        "verdict": { "type": "string" },
        "verdictNotes": { "type": "string" },
        "screenshotUrls": { "type": "array" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "publishedToWhatsApp": { "type": "boolean" },
        "publishedAt": { "type": "string" }
      },
      "required": ["id", "pair", "timeframe", "setupModel"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User specific configurations such as WhatsApp groups",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "whatsappGroups": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles for authenticated traders"
    },
    "/experiments/{experimentId}": {
      "schema": "Experiment",
      "description": "Trading research experiments and backtest records"
    },
    "/user_settings/{userId}": {
      "schema": "UserSettings",
      "description": "User-specific settings and preferences"
    }
  }
}
